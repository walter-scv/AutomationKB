# Base URL of the app under test.
BASE_URL=<url of the environment to test>

# Environment: local | staging | production
ENV=<local|staging|production>

# Playwright settings
HEADLESS=<true|false>
SLOWMO=<milliseconds to slow down each Playwright action>

# Test user credentials — this app has no login, so these are unused today.
# They exist as the convention for the day a fixture like `authenticatedPage`
# (see tests/base-test.ts) needs them. Never put a real value here — only in
# your local .env, which is gitignored and never committed.
# TEST_USER_EMAIL=<test account email>
# TEST_USER_PASSWORD=<test account password>

# Catalog assets, read directly from process.env wherever a test or Page
# Object needs them — no shared file in between. Named by role (PRIMARY,
# SECONDARY), not by which real asset currently fills that role: if the
# catalog reassigns the role to a different asset, only the values below
# change, never the variable names or the code that reads them. Id and
# display name travel together: override both together.
# ASSET_PRIMARY_ID=<catalog id of the primary asset>
# ASSET_PRIMARY_NAME=<display name shown in the UI for the primary asset>
# ASSET_SECONDARY_ID=<catalog id of the secondary asset>
# ASSET_SECONDARY_NAME=<display name shown in the UI for the secondary asset>
